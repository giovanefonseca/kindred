{
  "expo": {
    "name": "Kindred",
    "slug": "kindred-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kindred-logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/kindred-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Kindred precisa de acesso ao microfone para permitir anotações por voz.",
        "NSSpeechRecognitionUsageDescription": "O Kindred usa o reconhecimento de voz para transformar sua fala em anotações de saúde."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-kindred.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.kindred",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#004D25",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir o uso do microfone para criar anotações de voz.",
          "speechRecognitionPermission": "Permitir o reconhecimento de fala para converter sua voz em texto."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9e566f65-1ed9-4299-a565-b3943665865c"
      }
    },
    "owner": "kindred-tcc"
  }
}